{
  "version": "v1.0",

  "listeners": [
    {
      "id": "$listener",
      "doc": "Webhook listener that dispatches each inbound GitHub event to the concrete service type matching its event category.",
      "type": { "name": "Listener" },
      "services": [
        "$issues",
        "$issueComment",
        "$pullRequest",
        "$pullRequestReview",
        "$pullRequestReviewComment",
        "$release",
        "$label",
        "$milestone",
        "$push",
        "$projectCard"
      ],
      "multipleServicesAllowed": true
    }
  ],

  "serviceTypes": [
    {
      "id": "$issues",
      "doc": "Receives issue events: opened, closed, edited, and the other issue lifecycle actions.",
      "type": { "name": "IssuesService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$issueComment",
      "doc": "Receives issue comment events: created, edited, and deleted.",
      "type": { "name": "IssueCommentService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$pullRequest",
      "doc": "Receives pull request events: opened, closed, merged, and the other pull request lifecycle actions.",
      "type": { "name": "PullRequestService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$pullRequestReview",
      "doc": "Receives pull request review events: submitted, edited, and dismissed.",
      "type": { "name": "PullRequestReviewService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$pullRequestReviewComment",
      "doc": "Receives pull request review comment events: created, edited, and deleted.",
      "type": { "name": "PullRequestReviewCommentService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$release",
      "doc": "Receives release events: published, edited, and deleted.",
      "type": { "name": "ReleaseService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$label",
      "doc": "Receives label events: created, edited, and deleted.",
      "type": { "name": "LabelService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$milestone",
      "doc": "Receives milestone events: created, closed, opened, edited, and deleted.",
      "type": { "name": "MilestoneService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$push",
      "doc": "Receives push events, one per push to a repository branch.",
      "type": { "name": "PushService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    },
    {
      "id": "$projectCard",
      "doc": "Receives project card events: created, edited, moved, converted, and deleted.",
      "type": { "name": "ProjectCardService" },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": { "backedByConcreteType": true }
    }
  ]
}
